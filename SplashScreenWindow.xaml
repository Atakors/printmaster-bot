<Window x:Class="PrintMasterA4.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintMaster A4 Starting..." 
        Height="420" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="#181B24" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <!-- 3D Logo Icon -->
                <RowDefinition Height="140"/>
                <!-- App Title & Tagline -->
                <RowDefinition Height="Auto"/>
                <!-- Developer Info Badge -->
                <RowDefinition Height="Auto"/>
                <!-- Social Links -->
                <RowDefinition Height="Auto"/>
                <!-- Bottom Loading & Version -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. 3D Logo Icon -->
            <Image Grid.Row="0" Source="Assets/logo_icon.png" Width="135" Height="135" 
                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="25" ShadowDepth="0" Opacity="0.45"/>
                </Image.Effect>
            </Image>

            <!-- 2. Title Header -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="PrintMaster " FontSize="25" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="A4" FontSize="25" FontWeight="Bold" Foreground="#F97316"/>
                </StackPanel>
                <TextBlock Text="Duplicator &amp; Poster Maker" FontSize="12.5" Foreground="#94A3B8" 
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 3. Developer Badge -->
            <Border Grid.Row="2" Background="#1E293B" BorderBrush="#2563EB" BorderThickness="1" 
                    CornerRadius="6" Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Developed by aitadz.pro" FontSize="12.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
            </Border>

            <!-- 4. Developer Contacts Row -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="📘 facebook.com/aitadz.pro" FontSize="11" Foreground="#CBD5E1"/>
                <TextBlock Text="  •  " FontSize="11" Foreground="#475569"/>
                <TextBlock Text="✈️ t.me/aitadz" FontSize="11" Foreground="#CBD5E1"/>
                <TextBlock Text="  •  " FontSize="11" Foreground="#475569"/>
                <TextBlock Text="💬 wa.me/213558655085" FontSize="11" Foreground="#CBD5E1"/>
            </StackPanel>

            <!-- 5. Loading Bar & Status -->
            <Grid Grid.Row="4" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock x:Name="TxtStatus" Text="Starting application..." FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                    <TextBlock Text="v3.0" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Modern Loading Progress Bar -->
                <ProgressBar Grid.Row="1" x:Name="ProgBar" Height="5" Minimum="0" Maximum="100" Value="20"
                             Foreground="#38BDF8" Background="#0F172A" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
