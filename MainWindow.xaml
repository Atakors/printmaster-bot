<Window x:Class="PrintMasterA4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrintMaster A4: Duplicator &amp; Poster Maker" 
        Icon="Assets/app_icon.ico"
        Height="960" Width="1480"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Blueprint Grid Background for Canvas Workspace -->
        <DrawingBrush x:Key="BlueprintGridBrush" Viewport="0,0,24,24" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F1F5F9">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#E2E8F0">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="24,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,24"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E2E8F0" Thickness="1"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Section Header Style -->
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#CBD5E1" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Dark Navy) -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B4C7E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#172554"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <!-- Top Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= TOP MENU BAR ======================= -->
        <Menu Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,3">
            <MenuItem Header="File">
                <MenuItem Header="Open Image..." Click="BtnBrowse_Click"/>
                <MenuItem Header="Export Multi-Page PDF..." Click="BtnExportPdf_Click"/>
                <MenuItem Header="Export 300 DPI Image (PNG/JPG)..." Click="BtnExportImage_Click"/>
                <Separator/>
                <MenuItem Header="Print to PDF / Paper" Click="BtnPrintToPdfPaper_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Auto-Fit Duplicates" Click="BtnAutoFitGrid_Click"/>
                <MenuItem Header="Reset Dimensions" Click="BtnResetDimensions_Click"/>
            </MenuItem>
            <MenuItem Header="Margins">
                <MenuItem Header="Standard / Normal (10 mm)" Click="MenuMarginNormal_Click"/>
                <MenuItem Header="Narrow (5 mm)" Click="MenuMarginNarrow_Click"/>
                <MenuItem Header="None / Borderless (0 mm)" Click="MenuMarginNone_Click"/>
                <MenuItem Header="Wide (20 mm)" Click="MenuMarginWide_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Zoom In" Click="MenuZoomIn_Click"/>
                <MenuItem Header="Zoom Out" Click="MenuZoomOut_Click"/>
                <MenuItem Header="Fit to Screen" Click="BtnFitToScreen_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About PrintMaster A4" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ======================= MAIN CONTENT ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Control Panel -->
                <ColumnDefinition Width="315" MinWidth="290" MaxWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Right Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Padding="14,8,14,14">
                <StackPanel>
                    <!-- 1. Image Source -->
                    <TextBlock Text="Image Source" Style="{StaticResource SidebarHeaderStyle}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail Preview Box -->
                        <Border Grid.Column="0" Width="48" Height="48" HorizontalAlignment="Left" 
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <Image x:Name="ImgThumbnail" Stretch="Uniform" Margin="2"/>
                        </Border>

                        <!-- Browse & Filename -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnBrowse" Content="Browse Image..." Click="BtnBrowse_Click" 
                                    Style="{StaticResource SecondaryBtnStyle}" Height="26" HorizontalAlignment="Left" Padding="10,2"/>
                            <TextBlock x:Name="TxtImageFilename" Text="sticker_cute_cat.png" FontSize="10.5" 
                                       Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Orientation -->
                    <TextBlock Text="Orientation" Style="{StaticResource SidebarHeaderStyle}"/>
                    <StackPanel Margin="0,0,0,3">
                        <RadioButton x:Name="RbPortrait" IsChecked="True" Checked="Orientation_Changed" Margin="0,1,0,3">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Portrait (A4)" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="Portrait (210 × 297 mm)" FontSize="9.5" Foreground="#64748B"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbLandscape" Checked="Orientation_Changed" Margin="0,2,0,2">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Landscape (A4)" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock Text="Landscape (297 × 210 mm)" FontSize="9.5" Foreground="#64748B"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 3. Operation Mode -->
                    <TextBlock Text="Operation Mode" Style="{StaticResource SidebarHeaderStyle}"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mode 1: Image Duplicator Card -->
                        <Border x:Name="BorderModeDuplicator" Grid.Column="0" Background="#F0F7FF" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="4">
                            <Button Click="BtnSelectModeDuplicator_Click" Background="Transparent" BorderThickness="0" Padding="4,6" Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,0,2">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="9.5" Canvas.Top="2" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="17" Canvas.Top="2" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="2" Canvas.Top="9.5" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="17" Canvas.Top="9.5" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="2" Canvas.Top="17" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="9.5" Canvas.Top="17" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="17" Canvas.Top="17" Width="5" Height="5" Fill="#2563EB" RadiusX="1" RadiusY="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtModeDuplicator" Text="Image Duplicator" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Mode 2: Poster Maker Card -->
                        <Border x:Name="BorderModePoster" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <Button Click="BtnSelectModePoster_Click" Background="Transparent" BorderThickness="0" Padding="4,6" Cursor="Hand">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,0,2">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Canvas.Left="3" Canvas.Top="2" Width="8" Height="20" Stroke="#64748B" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                            <Rectangle Canvas.Left="13" Canvas.Top="2" Width="8" Height="20" Stroke="#64748B" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TxtModePoster" Text="Poster Maker" FontSize="10.5" FontWeight="Normal" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- ============================================================= -->
                    <!-- 4A. PANEL 1: IMAGE DUPLICATOR OPTIONS (VISIBLE ON STARTUP)    -->
                    <!-- ============================================================= -->
                    <StackPanel x:Name="PanelDuplicatorOptions" Visibility="Visible">
                        <!-- Standard Presets -->
                        <TextBlock Text="Standard Card / Photo Sizes:" FontSize="10.5" Foreground="#475569" Margin="0,2,0,2"/>
                        <ComboBox x:Name="CmbStandardPresets" SelectionChanged="CmbStandardPresets_SelectionChanged" Margin="0,0,0,5">
                            <ComboBoxItem Content="-- Choose Standard Size --" IsSelected="True"/>
                            <ComboBoxItem Content="Passport / ID Photo (3.5 × 4.5 cm)"/>
                            <ComboBoxItem Content="US Visa / Square (5.1 × 5.1 cm)"/>
                            <ComboBoxItem Content="Standard Business Card (8.5 × 5.5 cm)"/>
                            <ComboBoxItem Content="Credit Card / ID Badge (8.5 × 5.4 cm)"/>
                            <ComboBoxItem Content="A6 Postcard (10.5 × 14.8 cm)"/>
                            <ComboBoxItem Content="A5 Flyer (14.8 × 21.0 cm)"/>
                            <ComboBoxItem Content="Polaroid Sticker (7.0 × 7.0 cm)"/>
                        </ComboBox>

                        <!-- Quick Layout Presets -->
                        <TextBlock Text="Quick Layouts (Copies / Page):" FontSize="10.5" Foreground="#475569" Margin="0,1,0,2"/>
                        <WrapPanel Margin="0,0,0,5">
                            <Button Content="1-Up" Style="{StaticResource PresetBtnStyle}" Tag="1,1" Click="PresetButton_Click"/>
                            <Button Content="2-Up" Style="{StaticResource PresetBtnStyle}" Tag="2,1" Click="PresetButton_Click"/>
                            <Button Content="4-Up" Style="{StaticResource PresetBtnStyle}" Tag="2,2" Click="PresetButton_Click"/>
                            <Button Content="6-Up" Style="{StaticResource PresetBtnStyle}" Tag="3,2" Click="PresetButton_Click"/>
                            <Button Content="8-Up" Style="{StaticResource PresetBtnStyle}" Tag="4,2" Click="PresetButton_Click"/>
                            <Button Content="9-Up" Style="{StaticResource PresetBtnStyle}" Tag="3,3" Click="PresetButton_Click"/>
                            <Button Content="12-Up" Style="{StaticResource PresetBtnStyle}" Tag="4,3" Click="PresetButton_Click"/>
                            <Button Content="16-Up" Style="{StaticResource PresetBtnStyle}" Tag="4,4" Click="PresetButton_Click"/>
                            <Button Content="24-Up" Style="{StaticResource PresetBtnStyle}" Tag="6,4" Click="PresetButton_Click"/>
                        </WrapPanel>

                        <!-- 4. Image Dimensions -->
                        <TextBlock Text="Image Dimensions" Style="{StaticResource SidebarHeaderStyle}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <!-- Width Input -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Width:" VerticalAlignment="Center" FontSize="11" Foreground="#334155"/>
                            <TextBox x:Name="TxtWidthCm" Grid.Row="0" Grid.Column="1" Text="5.0 cm" TextChanged="TxtWidthCm_TextChanged"/>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Button Content="▲" Click="BtnWidthUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                <Button Content="▼" Click="BtnWidthDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                            </StackPanel>

                            <!-- Height Input -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Height:" VerticalAlignment="Center" FontSize="11" Foreground="#334155"/>
                            <TextBox x:Name="TxtHeightCm" Grid.Row="2" Grid.Column="1" Text="5.0 cm" TextChanged="TxtHeightCm_TextChanged"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Button Content="▲" Click="BtnHeightUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                <Button Content="▼" Click="BtnHeightDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkLockRatio" Content="Lock Aspect Ratio" IsChecked="True" Margin="0,1,0,5"/>

                        <!-- 5. Page Margins (Paper Edge) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="📏 Page Margins (Paper Edge):" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,3"/>

                                <!-- Margin Presets ComboBox -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Preset:" VerticalAlignment="Center" FontSize="10.5" Width="44"/>
                                    <ComboBox x:Name="CmbMarginPresets" SelectionChanged="CmbMarginPresets_SelectionChanged" Height="24" FontSize="10.5">
                                        <ComboBoxItem Content="Standard / Normal (10.0 mm)" IsSelected="True"/>
                                        <ComboBoxItem Content="Narrow (5.0 mm)"/>
                                        <ComboBoxItem Content="None / Borderless (0.0 mm)"/>
                                        <ComboBoxItem Content="Wide (20.0 mm)"/>
                                        <ComboBoxItem Content="Custom (Manual)"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Uniform Manual Margin Input -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Margin:" VerticalAlignment="Center" FontSize="10.5" Foreground="#334155"/>
                                    <TextBox x:Name="TxtPageMarginMm" Grid.Column="1" Text="10.0 mm" Height="24" TextChanged="TxtPageMarginMm_TextChanged"/>
                                    <StackPanel Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Button Content="▲" Click="BtnPageMarginUp_Click" FontSize="6.5" Height="11" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                        <Button Content="▼" Click="BtnPageMarginDown_Click" FontSize="6.5" Height="11" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Independent 4-way margins expander -->
                                <Expander Header="Custom 4-Way Margins (T, B, L, R)" Margin="0,2,0,4">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Top" FontSize="9.5" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtMarginTop" Text="10" Height="22" FontSize="10" TextChanged="IndependentMargin_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Bottom" FontSize="9.5" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtMarginBottom" Text="10" Height="22" FontSize="10" TextChanged="IndependentMargin_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Left" FontSize="9.5" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtMarginLeft" Text="10" Height="22" FontSize="10" TextChanged="IndependentMargin_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Right" FontSize="9.5" Foreground="#64748B"/>
                                            <TextBox x:Name="TxtMarginRight" Text="10" Height="22" FontSize="10" TextChanged="IndependentMargin_TextChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander>

                                <CheckBox x:Name="ChkShowMarginGuide" Content="Show printable margin guide line" IsChecked="True" 
                                          FontSize="10" Foreground="#475569" Checked="MarginGuide_Changed" Unchecked="MarginGuide_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. Spacing & Grid (Image Gap & Auto-fit) -->
                        <TextBlock Text="Spacing &amp; Grid" Style="{StaticResource SidebarHeaderStyle}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Gap:" VerticalAlignment="Center" FontSize="11" Foreground="#334155"/>
                            <TextBox x:Name="TxtGapMm" Grid.Column="1" Text="3.0 mm" TextChanged="TxtGapMm_TextChanged"/>
                            <StackPanel Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Button Content="▲" Click="BtnGapUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                <Button Content="▼" Click="BtnGapDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,0,0,5">
                            <CheckBox x:Name="ChkAutoFitDuplicates" IsChecked="True" Checked="ChkAutoFitDuplicates_Changed" Unchecked="ChkAutoFitDuplicates_Changed"
                                      Content="Auto-Fit Duplicates" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- ================= 7. COPIES & BATCH EXPORT ================= -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Padding="8,7" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="📑 Copies &amp; Batch Export" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtBatchSheetBadge" Text="1 Sheet (Auto)" FontSize="9.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </Border>
                                </DockPanel>

                                <!-- Total Copies Input -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Copies Needed:" VerticalAlignment="Center" FontSize="10.5" Foreground="#334155"/>
                                    <TextBox x:Name="TxtTotalBatchCopies" Grid.Column="1" Text="0" Height="24" FontSize="11" FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             ToolTip="Set 0 to fit 1 page, or enter any count (e.g. 50, 100) for multi-sheet PDF export"
                                             TextChanged="Options_Changed"/>
                                    <StackPanel Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Button Content="▲" Click="BtnBatchCopiesUp_Click" FontSize="6.5" Height="11" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                        <Button Content="▼" Click="BtnBatchCopiesDown_Click" FontSize="6.5" Height="11" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Quick Presets -->
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="1 Page" Style="{StaticResource PresetBtnStyle}" Tag="0" Click="BtnBatchPreset_Click" ToolTip="Fill 1 single page"/>
                                    <Button Content="20" Style="{StaticResource PresetBtnStyle}" Tag="20" Click="BtnBatchPreset_Click"/>
                                    <Button Content="50" Style="{StaticResource PresetBtnStyle}" Tag="50" Click="BtnBatchPreset_Click"/>
                                    <Button Content="100" Style="{StaticResource PresetBtnStyle}" Tag="100" Click="BtnBatchPreset_Click"/>
                                    <Button Content="200" Style="{StaticResource PresetBtnStyle}" Tag="200" Click="BtnBatchPreset_Click"/>
                                    <Button Content="500" Style="{StaticResource PresetBtnStyle}" Tag="500" Click="BtnBatchPreset_Click"/>
                                </WrapPanel>

                                <!-- Copy Limiting per Sheet -->
                                <DockPanel Margin="0,0,0,3">
                                    <CheckBox x:Name="ChkLimitCopies" Content="Limit copies / sheet:" VerticalAlignment="Center" FontSize="10"
                                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                                    <TextBox x:Name="TxtMaxCopies" Text="24" Width="44" Height="22" HorizontalAlignment="Right"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="10.5"
                                             TextChanged="Options_Changed"/>
                                </DockPanel>

                                <!-- Informative details -->
                                <TextBlock x:Name="TxtBatchCopiesDetail" 
                                           Text="Set total copies (e.g. 50, 100) to export a multi-page PDF spanning all sheets."
                                           FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ================= ADVANCED OPTIONS ================= -->
                        <Expander Header="Advanced Print &amp; Cut Options" IsExpanded="False" Margin="0,0,0,6">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,3,0,0">
                                <StackPanel>
                                    <!-- Cut Marks -->
                                    <CheckBox x:Name="ChkCutMarks" Content="✂️ Show &amp; Print Cut Marks" IsChecked="True" 
                                              Margin="0,0,0,5" Checked="Options_Changed" Unchecked="Options_Changed"/>

                                    <!-- Image Border -->
                                    <DockPanel Margin="0,0,0,5">
                                        <CheckBox x:Name="ChkImageBorder" Content="Border:" VerticalAlignment="Center" 
                                                  Checked="Options_Changed" Unchecked="Options_Changed"/>
                                        <ComboBox x:Name="CmbBorderColor" Width="64" Margin="3,0,0,0" SelectionChanged="Options_Changed">
                                            <ComboBoxItem Content="Black" IsSelected="True"/>
                                            <ComboBoxItem Content="Gray"/>
                                            <ComboBoxItem Content="White"/>
                                            <ComboBoxItem Content="Red"/>
                                        </ComboBox>
                                        <TextBox x:Name="TxtBorderThicknessMm" Text="0.5" Width="30" Margin="3,0,0,0" 
                                                 HorizontalAlignment="Right" TextChanged="Options_Changed"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" FontSize="9.5" Margin="2,0,0,0"/>
                                    </DockPanel>

                                    <!-- Auto-Rotate Optimization -->
                                    <CheckBox x:Name="ChkAutoRotate" Content="Auto-rotate 90° for max yield" Margin="0,0,0,5" 
                                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                                    <!-- Sheet Alignment -->
                                    <DockPanel>
                                        <TextBlock Text="Alignment:" VerticalAlignment="Center" FontSize="10.5"/>
                                        <ComboBox x:Name="CmbAlignment" Width="100" HorizontalAlignment="Right" SelectionChanged="Options_Changed">
                                            <ComboBoxItem Content="Center on Sheet" IsSelected="True"/>
                                            <ComboBoxItem Content="Top-Left Aligned"/>
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Bottom Grid Calculation Summary Text -->
                        <TextBlock x:Name="TxtGridSummary" Text="Grid calculation: 15 images fit this page (3 x 5 pattern)" 
                                   FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    </StackPanel>

                    <!-- ============================================================= -->
                    <!-- 4B. PANEL 2: POSTER MAKER OPTIONS (SHOWN WHEN POSTER ACTIVE)  -->
                    <!-- ============================================================= -->
                    <StackPanel x:Name="PanelPosterOptions" Visibility="Collapsed">
                        <!-- Quick Poster Presets -->
                        <TextBlock Text="Poster Sheet Presets:" FontSize="10.5" Foreground="#475569" Margin="0,2,0,2"/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="2 × 2 (~A2)" Style="{StaticResource PresetBtnStyle}" Tag="2,2" Click="PosterPresetButton_Click" ToolTip="4 A4 Sheets (approx 42 × 60 cm)"/>
                            <Button Content="3 × 3 (~A0)" Style="{StaticResource PresetBtnStyle}" Tag="3,3" Click="PosterPresetButton_Click" ToolTip="9 A4 Sheets (approx 63 × 89 cm)"/>
                            <Button Content="2 × 1 (Wide)" Style="{StaticResource PresetBtnStyle}" Tag="2,1" Click="PosterPresetButton_Click" ToolTip="2 A4 Sheets Side-by-Side"/>
                            <Button Content="3 × 2 (Poster)" Style="{StaticResource PresetBtnStyle}" Tag="3,2" Click="PosterPresetButton_Click" ToolTip="6 A4 Sheets"/>
                            <Button Content="4 × 4 (Giant)" Style="{StaticResource PresetBtnStyle}" Tag="4,4" Click="PosterPresetButton_Click" ToolTip="16 A4 Sheets (approx 84 × 118 cm)"/>
                        </WrapPanel>

                        <!-- Custom Sheet Grid -->
                        <TextBlock Text="Poster Tiling Grid (A4 Pages)" Style="{StaticResource SidebarHeaderStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Columns / Across -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Across (H):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPosterCols" Grid.Column="0" Text="2" Height="26" VerticalContentAlignment="Center" TextChanged="PosterDimension_TextChanged"/>
                                    <StackPanel Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Button Content="▲" Click="BtnPosterColsUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                        <Button Content="▼" Click="BtnPosterColsDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- Rows / Down -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Down (V):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPosterRows" Grid.Column="0" Text="2" Height="26" VerticalContentAlignment="Center" TextChanged="PosterDimension_TextChanged"/>
                                    <StackPanel Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Button Content="▲" Click="BtnPosterRowsUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                        <Button Content="▼" Click="BtnPosterRowsDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Overlap & Assembly Margin -->
                        <TextBlock Text="Assembly &amp; Glue Overlap" Style="{StaticResource SidebarHeaderStyle}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Overlap:" VerticalAlignment="Center" FontSize="10.5" Foreground="#334155"/>
                            <TextBox x:Name="TxtPosterOverlapMm" Grid.Column="1" Text="10 mm" Height="26" VerticalContentAlignment="Center" TextChanged="PosterDimension_TextChanged"/>
                            <StackPanel Grid.Column="2" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Button Content="▲" Click="BtnPosterOverlapUp_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                                <Button Content="▼" Click="BtnPosterOverlapDown_Click" FontSize="6.5" Height="12" Padding="0" Style="{StaticResource SecondaryBtnStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Overlap Quick Presets -->
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="0 mm" Style="{StaticResource PresetBtnStyle}" Tag="0" Click="BtnPosterOverlapPreset_Click" ToolTip="No overlap / Edge-to-edge"/>
                            <Button Content="5 mm" Style="{StaticResource PresetBtnStyle}" Tag="5" Click="BtnPosterOverlapPreset_Click"/>
                            <Button Content="10 mm (Std)" Style="{StaticResource PresetBtnStyle}" Tag="10" Click="BtnPosterOverlapPreset_Click"/>
                            <Button Content="15 mm" Style="{StaticResource PresetBtnStyle}" Tag="15" Click="BtnPosterOverlapPreset_Click"/>
                            <Button Content="20 mm" Style="{StaticResource PresetBtnStyle}" Tag="20" Click="BtnPosterOverlapPreset_Click"/>
                        </WrapPanel>

                        <!-- Poster Guides & Cutting Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Guides &amp; Cutting Marks:" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkPosterGuides" Content="Print glue lines &amp; sheet labels" IsChecked="True" 
                                          FontSize="10.5" Margin="0,0,0,4" Checked="PosterDimension_TextChanged" Unchecked="PosterDimension_TextChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Calculation Summary for Poster -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                            <StackPanel>
                                <TextBlock Text="📌 Poster Summary:" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtPosterSummary" Text="Poster: 4 A4 pages (2 × 2) • Overlap: 10 mm" 
                                           FontSize="10" Foreground="#2563EB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 7. Action Buttons -->
                    <Button x:Name="BtnPrintToPdfPaper" Content="Print to PDF / Paper" Click="BtnPrintToPdfPaper_Click" 
                            Style="{StaticResource PrimaryActionBtnStyle}" Height="34" Margin="0,2,0,5"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Export PDF" Click="BtnExportPdf_Click" 
                                Style="{StaticResource SecondaryBtnStyle}" Height="28"/>
                        <Button Grid.Column="2" Content="Export 300 DPI" Click="BtnExportImage_Click" 
                                Style="{StaticResource SecondaryBtnStyle}" Height="28"/>
                    </Grid>

                    <Button x:Name="BtnSaveProject" Content="Save Project" Click="BtnSaveProject_Click" 
                            Style="{StaticResource SecondaryBtnStyle}" Height="26" Margin="0,0,0,6"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Splitter border -->
            <Border Grid.Column="1" Width="1" Background="#E2E8F0"/>

            <!-- RIGHT WORKSPACE (Blueprint Grid + Centered A4 Sheet) -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource BlueprintGridBrush}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                    <Grid.RowDefinitions>
                        <!-- Top Canvas Sheet Indicator Label -->
                        <RowDefinition Height="Auto"/>
                        <!-- Sheet Canvas -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="0.85" ScaleY="0.85"/>
                    </Grid.LayoutTransform>

                    <!-- Sheet Title Label -->
                    <TextBlock Grid.Row="0" x:Name="TxtCanvasSheetTitle" Text="Canvas: A4 Sheet 1 of 1" 
                               FontSize="12" Foreground="#475569" FontWeight="Medium" 
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- White A4 Sheet with DropShadow -->
                    <Border Grid.Row="1" x:Name="PaperBorder" Background="#FFFFFF" Width="793.7" Height="1122.5" 
                            CornerRadius="2" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                        <Border.Effect>
                            <DropShadowEffect Color="#64748B" BlurRadius="22" ShadowDepth="4" Opacity="0.35"/>
                        </Border.Effect>

                        <Grid>
                            <!-- Main Drawing Canvas -->
                            <Canvas x:Name="A4Canvas" ClipToBounds="True" Background="White"/>

                            <!-- Printable Margin Guide Line -->
                            <Canvas x:Name="MarginGuideCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="RectMarginGuide" Stroke="#94A3B8" StrokeThickness="1" 
                                           StrokeDashArray="4,4" IsHitTestVisible="False"/>
                            </Canvas>

                            <!-- Selection Box with Dimension Badges (Top-Left Active Item) -->
                            <Canvas x:Name="SelectionAdornerCanvas" IsHitTestVisible="False">
                                <!-- Blue Selection Outline -->
                                <Rectangle x:Name="RectSelection" Stroke="#2563EB" StrokeThickness="1.5" IsHitTestVisible="False"/>

                                <!-- Dimension Badge Top -->
                                <Border x:Name="BadgeTop" Background="#FFFFFF" BorderBrush="#2563EB" BorderThickness="1" 
                                        CornerRadius="2" Padding="4,1">
                                    <TextBlock x:Name="TxtBadgeTop" Text="5.0 cm" FontSize="9" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                </Border>

                                <!-- Dimension Badge Left -->
                                <Border x:Name="BadgeLeft" Background="#FFFFFF" BorderBrush="#2563EB" BorderThickness="1" 
                                        CornerRadius="2" Padding="4,1">
                                    <TextBlock x:Name="TxtBadgeLeft" Text="5.0 cm" FontSize="9" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                </Border>

                                <!-- Corner Handles -->
                                <Ellipse x:Name="HandleTL" Width="7" Height="7" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="1.5"/>
                                <Ellipse x:Name="HandleTR" Width="7" Height="7" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="1.5"/>
                                <Ellipse x:Name="HandleBL" Width="7" Height="7" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="1.5"/>
                                <Ellipse x:Name="HandleBR" Width="7" Height="7" Fill="#FFFFFF" Stroke="#2563EB" StrokeThickness="1.5"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ======================= BOTTOM STATUS BAR ======================= -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Height="28" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Status Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#475569"/>
                    <TextBlock Text=" | " FontSize="11" Foreground="#CBD5E1" Margin="8,0"/>
                    <TextBlock Text="Dimension Mode: cm" FontSize="11" Foreground="#64748B"/>
                </StackPanel>

                <!-- Right Zoom Controls -->
                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="–" Click="BtnZoomOut_Click" Background="Transparent" BorderThickness="0" 
                                FontSize="12" FontWeight="Bold" Foreground="#475569" Padding="4,0" Cursor="Hand"/>
                        <TextBlock x:Name="TxtZoomLevel" Text="85%" FontSize="11" Foreground="#334155" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="+" Click="BtnZoomIn_Click" Background="Transparent" BorderThickness="0" 
                                FontSize="12" FontWeight="Bold" Foreground="#475569" Padding="4,0" Cursor="Hand"/>
                        <TextBlock Text=" | " FontSize="11" Foreground="#E2E8F0" Margin="4,0"/>
                        <Button Content="[Fit to Screen]" Click="BtnFitToScreen_Click" Background="Transparent" BorderThickness="0" 
                                FontSize="10.5" Foreground="#2563EB" Cursor="Hand" Padding="2,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
