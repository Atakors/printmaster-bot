<Window x:Class="PrintMasterA4.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PrintMaster A4" 
        Icon="Assets/app_icon.ico"
        Height="430" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Image Source="Assets/logo_icon.png" Width="64" Height="64" Margin="0,0,0,8" HorizontalAlignment="Center" Stretch="Uniform"/>
            <TextBlock Text="PrintMaster A4" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center"/>
            <TextBlock Text="Duplicator &amp; Poster Maker — Version 3.0" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,8"/>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                <TextBlock Text="Developed by aitadz.pro" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Contact Links Card -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Contact &amp; Support:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,10"/>

                <!-- Facebook -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="📘 Facebook:" FontWeight="Medium" Width="90" Foreground="#475569"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://www.facebook.com/aitadz.pro" RequestNavigate="Hyperlink_RequestNavigate">
                            https://www.facebook.com/aitadz.pro
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>

                <!-- Telegram -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="✈️ Telegram:" FontWeight="Medium" Width="90" Foreground="#475569"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://t.me/aitadz" RequestNavigate="Hyperlink_RequestNavigate">
                            t.me/aitadz
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>

                <!-- Whatsapp -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="💬 WhatsApp:" FontWeight="Medium" Width="90" Foreground="#475569"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://wa.me/213558655085" RequestNavigate="Hyperlink_RequestNavigate">
                            https://wa.me/213558655085
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" Click="BtnClose_Click" IsDefault="True"
                Width="90" Height="32" HorizontalAlignment="Center" Margin="0,16,0,0"
                Background="#2B4C7E" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
